{
  "stryker-config": {
    "project": "Buildingway.Tools.csproj",
    "reporters": [ "progress", "html", "markdown", "json" ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/*.cs",
      "!**/Shell.cs",
      "!**/Python.cs",
      "!**/GitHub.cs",
      "!**/Program.cs",
      "!**/StrykerHost.cs"
    ]
  }
}
